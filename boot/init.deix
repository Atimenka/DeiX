# Скрипт инициализации и развертывания DeiX OS — мастер-карта разделов

on init_boot
    mount erofs /dev/block/by-name/kernel /kernel ro
    mount erofs /dev/block/by-name/init_boot /init_boot ro
    mount devfs devfs /dev rw
    mount procfs procfs /proc ro
    service pid1_core /bin/pid1_core 0
    service syslogd /bin/syslogd 0
    service auth_broker /bin/auth_broker 0
    service vfs_flusher /bin/vfs_flusher 0

on vendor_boot
    mount erofs /dev/block/by-name/vendor_boot /vendor_boot ro
    service vendor_hal /bin/vendor_hal 0

on boot
    mount erofs /dev/block/by-name/super /system ro
    mount ext4 /dev/block/by-name/userdata /userdata rw
    service security_monitor /bin/security_monitor 3
    service net_daemon /bin/net_daemon 3
